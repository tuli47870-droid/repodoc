// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Repository {
  id            String   @id @default(cuid())
  provider      String   // e.g., "github"
  owner         String
  name          String
  fullName      String   @unique // e.g., "owner/repo"
  url           String
  defaultBranch String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  scans RepositoryScan[]

  @@index([provider, fullName])
  @@map("repositories")
}

model RepositoryScan {
  id            String    @id @default(cuid())
  repositoryId  String
  commitSha     String?
  branch        String?
  status        String    // QUEUED, RUNNING, COMPLETED, FAILED, CANCELLED
  currentStage  String?   // QUEUED, CLONING, MAPPING, READY, FAILED
  progress      Int       @default(0)
  progressMessage String?
  startedAt     DateTime?
  completedAt   DateTime?
  errorMessage  String?
  healthScore   Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  repository Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  artifacts  ScanArtifact[]
  findings   Finding[]
  aiUsage    AIUsage[]

  @@index([repositoryId])
  @@index([status])
  @@index([createdAt])
  @@map("repository_scans")
}

model ScanArtifact {
  id        String   @id @default(cuid())
  scanId    String
  type      String   // REPOSITORY_MANIFEST, etc.
  path      String?
  metadata  Json     // Flexible JSON storage for artifact data
  createdAt DateTime @default(now())

  scan RepositoryScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([type])
  @@map("scan_artifacts")
}

model Finding {
  id          String   @id @default(cuid())
  scanId      String
  category    String   // SECURITY, QUALITY, DEPENDENCY, ARCHITECTURE, BUILD, TEST, RUNTIME
  severity    String   // CRITICAL, HIGH, MEDIUM, LOW, INFO
  title       String
  description String   @db.Text
  location    Json?    // { file, line, column, snippet }
  evidence    Json?    // Additional context and evidence
  confidence  Float    @default(1.0) // 0.0 - 1.0
  fingerprint String   // For deduplication across scans
  scanner     String   // Which scanner found it
  metadata    Json?    // Scanner-specific metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scan      RepositoryScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  diagnoses Diagnosis[]

  @@index([scanId])
  @@index([category])
  @@index([severity])
  @@index([fingerprint])
  @@map("findings")
}

model Diagnosis {
  id             String   @id @default(cuid())
  findingId      String
  rootCause      String   @db.Text
  explanation    String   @db.Text
  impact         String   @db.Text
  recommendation String   @db.Text
  confidence     Float    @default(0.8) // 0.0 - 1.0
  aiProvider     String   // openai, anthropic, google
  aiModel        String   // gpt-4, claude-3-5-sonnet, etc.
  tokensUsed     Int
  costUsd        Float
  createdAt      DateTime @default(now())

  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@map("diagnoses")
}

model AIUsage {
  id           String   @id @default(cuid())
  scanId       String
  provider     String   // openai, anthropic, google
  model        String   // specific model name
  task         String   // diagnosis, analysis, etc.
  inputTokens  Int
  outputTokens Int
  totalTokens  Int
  costUsd      Float
  durationMs   Int
  success      Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())

  scan RepositoryScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([provider])
  @@index([createdAt])
  @@map("ai_usage")
}
